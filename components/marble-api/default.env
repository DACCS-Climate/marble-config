export MARBLE_API_COMPONENT_DIR="$(echo "${BIRDHOUSE_EXTRA_CONF_DIRS}" | grep 'marble-api[[:space:]]*$' | head -1 | xargs)"

export MARBLE_API_VERSION=1.0.0-rc.2
export MARBLE_API_DOCKER=marbleclimate/marble-api
export MARBLE_API_IMAGE='${MARBLE_API_DOCKER}:${MARBLE_API_VERSION}'

# percona is used instead of mongodb community image because it supports encryption at rest
# NOTE: mongodb versions > 8.0.4 are currently incompatible with recent malloc fix from linux kernels > 6.19
export MARBLE_API_MONGO_DOCKER=percona/percona-server-mongodb
export MARBLE_API_MONGO_VERSION=8.0.4
export MARBLE_API_MONGO_IMAGE='${MARBLE_API_MONGO_DOCKER}:${MARBLE_API_MONGO_VERSION}'

export MARBLE_API_DATA_DIR='${BIRDHOUSE_DATA_PERSIST_ROOT}/marble_api'

export MARBLE_API_ENABLE_ENCRYPTION=
export MARBLE_API_ENCRYPTION_KEY_FILE=


VARS="
    $VARS
    \$MARBLE_API_VERSION
"

DELAYED_EVAL="
    $DELAYED_EVAL
    MARBLE_API_IMAGE
    MARBLE_API_MONGO_IMAGE
    MARBLE_API_DATA_DIR
"
